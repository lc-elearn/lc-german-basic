    "summary": {
      "lead": "Listen and repeat. These phrases tell your host or agent when and for how long. You will learn:",
      "items": [
        "dates (<em>vom … bis zum …, Anfang, Mitte, Ende</em>);",
        "durations (<em>eine Woche, zwei Wochen, für drei Tage</em>)."
      ]
    },
