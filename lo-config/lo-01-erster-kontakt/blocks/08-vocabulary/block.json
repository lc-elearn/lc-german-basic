  "content": {
    "summary": {
      "lead": "Listen to each phrase, say it aloud, and notice which ones are formal and which informal. You will learn:",
      "items": [
        "greetings for different times of day (<em>Guten Morgen, Guten Tag, Guten Abend</em>);",
        "saying goodbye, formally and informally (<em>Auf Wiedersehen, Tschüs</em>);",
        "polite phrases (<em>danke, bitte, Entschuldigung</em>)."
      ]
    },
    "items": [
      {
        "term": "Guten Morgen!",
        "gloss": "Good morning!",
        "audio": "audio/lo-01-erster-kontakt/u1_v-greet-guten-morgen.mp3"
      },
      {
        "term": "Guten Tag!",
        "gloss": "Hello! / Good day!",
        "audio": "audio/lo-01-erster-kontakt/u1_v-greet-guten-tag.mp3"
      },
      {
        "term": "Guten Abend!",
        "gloss": "Good evening!",
        "audio": "audio/lo-01-erster-kontakt/u1_v-greet-guten-abend.mp3"
      },
      {
        "term": "Hallo!",
        "gloss": "Hello! (informal)",
