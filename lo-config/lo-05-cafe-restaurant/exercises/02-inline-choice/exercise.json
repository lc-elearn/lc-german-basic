{
  "type": "inline-choice",
  "title": "Accusative, kein and möchten",
  "content": {
    "instructions": "Choose the correct form for each sentence.",
    "items": [
      {
        "text": "Ich hätte gern [*einen|eine|ein] Kaffee."
      },
      {
        "text": "Ich nehme [*eine|einen|ein] Suppe."
      },
      {
        "text": "Ich esse [*kein|keinen|nicht] Fleisch."
