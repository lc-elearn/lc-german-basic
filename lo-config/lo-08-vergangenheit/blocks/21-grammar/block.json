      "<table><caption>Simple past of sein and haben</caption><thead><tr><th></th><th>sein</th><th>haben</th></tr></thead><tbody><tr><th>ich</th><td>war</td><td>hatte</td></tr><tr><th>du</th><td>warst</td><td>hattest</td></tr><tr><th>er / sie / es</th><td>war</td><td>hatte</td></tr><tr><th>wir</th><td>waren</td><td>hatten</td></tr><tr><th>ihr</th><td>wart</td><td>hattet</td></tr><tr><th>sie / Sie</th><td>waren</td><td>hatten</td></tr></tbody></table>",
